{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.org/schemas/external-closure-program.schema.json",
  "title": "Hepta Glasses external authority closure program",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "candidate_identity_rule",
    "claim_ceiling",
    "terminal_blocking_statuses",
    "gates"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "program_id": {"const": "hepta-glasses-external-closure-v1"},
    "candidate_identity_rule": {
      "type": "string",
      "minLength": 120,
      "maxLength": 2048
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 160,
      "maxLength": 4096
    },
    "terminal_blocking_statuses": {
      "const": [
        "BLOCKED_ADMIN_SETTING",
        "BLOCKED_EXTERNAL",
        "BLOCKED_UPSTREAM"
      ]
    },
    "gates": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 128
    },
    "gap_id": {
      "type": "string",
      "pattern": "^(?:HG-[0-9]{4}|G10-TRUST-REGISTRY)$"
    },
    "nonempty_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 12,
        "maxLength": 2048
      }
    },
    "source_references": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+(?:#[A-Za-z0-9_.:-]+)?$",
        "maxLength": 512
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gap_ids",
        "issue_numbers",
        "authority_class",
        "status",
        "owner",
        "source_preparation",
        "evidence_required",
        "acceptance",
        "prohibited_substitutes",
        "reopens_on"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "gap_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gap_id"}
        },
        "issue_numbers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          }
        },
        "authority_class": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
          "minLength": 8,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "BLOCKED_ADMIN_SETTING",
            "BLOCKED_EXTERNAL",
            "BLOCKED_UPSTREAM"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512
        },
        "source_preparation": {"$ref": "#/$defs/source_references"},
        "evidence_required": {"$ref": "#/$defs/nonempty_strings"},
        "acceptance": {"$ref": "#/$defs/nonempty_strings"},
        "prohibited_substitutes": {"$ref": "#/$defs/nonempty_strings"},
        "reopens_on": {"$ref": "#/$defs/nonempty_strings"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hepta.invalid/schemas/external-evidence-envelope-v1.json",
  "title": "Hepta authenticated authority-owned external evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "trust_registry",
    "candidate",
    "submissions",
    "acceptance"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "contract_id": {"const": "hepta-external-evidence-envelope-v1"},
    "trust_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "sha256"],
      "properties": {
        "registry_id": {"const": "hepta-external-authority-trust-registry-v1"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_commit",
        "source_tree",
        "contracts_revision",
        "collected_at"
      ],
      "properties": {
        "repository": {"const": "TrillionniumFoundation/hepta-glasses"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "contracts_revision": {"const": "2026-09-01-g8"},
        "release_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "binary_digests": {
          "type": "array",
          "items": {"$ref": "#/$defs/digest"},
          "uniqueItems": true,
          "maxItems": 32
        },
        "collected_at": {"type": "string", "format": "date-time"}
      }
    },
    "submissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/submission"}
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reviewed_at", "reviewers", "bundle_digest"],
      "properties": {
        "state": {
          "enum": [
            "incomplete",
            "eligible_for_review",
            "accepted",
            "rejected",
            "expired",
            "revoked"
          ]
        },
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "reviewers": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/reviewer"}
        },
        "bundle_digest": {"$ref": "#/$defs/sha256OrNull"},
        "decision_reference": {"type": ["string", "null"], "maxLength": 1000},
        "limitations": {
          "type": "array",
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha256OrNull": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "organization", "authority_class", "key_id"],
      "properties": {
        "identity": {"type": "string", "minLength": 1, "maxLength": 300},
        "organization": {"type": "string", "minLength": 1, "maxLength": 300},
        "authority_class": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"},
        "key_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "contact": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signed_at", "statement_digest", "signature_uri", "signature_sha256"],
      "properties": {
        "signed_at": {"type": "string", "format": "date-time"},
        "statement_digest": {"$ref": "#/$defs/sha256"},
        "signature_uri": {"type": "string", "pattern": "^artifact://[A-Za-z0-9._/-]{1,500}$"},
        "signature_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "uri",
        "sha256",
        "media_type",
        "issued_at",
        "contains_secrets",
        "synthetic"
      ],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,200}$"},
        "uri": {"type": "string", "pattern": "^artifact://[A-Za-z0-9._/-]{1,500}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 200},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "contains_secrets": {"const": false},
        "synthetic": {"type": "boolean"},
        "signature_uri": {
          "type": ["string", "null"],
          "pattern": "^artifact://[A-Za-z0-9._/-]{1,500}$"
        },
        "signature_sha256": {"$ref": "#/$defs/sha256OrNull"}
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "evidence_level",
        "issuer",
        "environment",
        "subjects",
        "claims",
        "artifacts",
        "result",
        "limitations",
        "attestation"
      ],
      "properties": {
        "gap_id": {"$ref": "#/$defs/gapId"},
        "evidence_level": {"enum": ["E5", "E6", "E7", "ADMIN", "UPSTREAM"]},
        "issuer": {"$ref": "#/$defs/issuer"},
        "environment": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 500},
          "uniqueItems": true
        },
        "claims": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 128,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{2,99}$"},
          "additionalProperties": {"type": "boolean"}
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "result": {"enum": ["pass", "fail", "inconclusive"]},
        "limitations": {
          "type": "array",
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "notes": {"type": ["string", "null"], "maxLength": 5000},
        "attestation": {"$ref": "#/$defs/attestation"}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "organization",
        "authority_class",
        "key_id",
        "decision",
        "reviewed_gap_ids",
        "review_uri",
        "review_sha256",
        "signed_at",
        "statement_digest",
        "signature_uri",
        "signature_sha256"
      ],
      "properties": {
        "identity": {"type": "string", "minLength": 1, "maxLength": 300},
        "organization": {"type": "string", "minLength": 1, "maxLength": 300},
        "authority_class": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"},
        "key_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "decision": {"enum": ["approve", "reject", "abstain"]},
        "reviewed_gap_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gapId"}
        },
        "review_uri": {"type": "string", "pattern": "^artifact://[A-Za-z0-9._/-]{1,500}$"},
        "review_sha256": {"$ref": "#/$defs/sha256"},
        "signed_at": {"type": "string", "format": "date-time"},
        "statement_digest": {"$ref": "#/$defs/sha256"},
        "signature_uri": {"type": "string", "pattern": "^artifact://[A-Za-z0-9._/-]{1,500}$"},
        "signature_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "gapId": {
      "enum": [
        "HG-0010",
        "HG-0011",
        "HG-0012",
        "HG-0013",
        "HG-0014",
        "HG-0015",
        "HG-0016",
        "HG-0017",
        "HG-0018",
        "HG-0021",
        "HG-0022",
        "HG-0044"
      ]
    }
  }
}

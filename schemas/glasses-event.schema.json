{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hepta.invalid/schemas/glasses-event-v1.json",
  "title": "GlassesEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "trace_id",
    "session_id",
    "device_id",
    "sequence",
    "timestamp",
    "origin",
    "event_type",
    "payload",
    "privacy_class",
    "deadline"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "enum": [
        "left-leg",
        "right-leg",
        "phone",
        "cloud",
        "simulator"
      ]
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "privacy_class": {
      "enum": [
        "public",
        "personal",
        "sensitive",
        "secret"
      ]
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    }
  }
}

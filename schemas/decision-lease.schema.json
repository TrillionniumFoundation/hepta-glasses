{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hepta.invalid/schemas/decision-lease-v1.json",
  "title": "DecisionLease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lease_id",
    "subject",
    "device_id",
    "task_id",
    "allowed_actions",
    "argument_digest",
    "expires_at",
    "single_use",
    "policy_hash"
  ],
  "properties": {
    "lease_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "argument_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "single_use": {
      "type": "boolean"
    },
    "policy_hash": {
      "type": "string",
      "minLength": 1
    },
    "approval_proof": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

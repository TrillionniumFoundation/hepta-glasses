{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hepta.invalid/schemas/external-evidence-trust-registry-v1.json",
  "title": "Hepta external evidence trust registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "generation",
    "issued_at",
    "expires_at",
    "keys"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "generation": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/key"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "identity",
        "organization",
        "algorithm",
        "public_key_pem",
        "public_key_sha256",
        "purposes",
        "authority_classes",
        "allowed_gap_ids",
        "valid_from",
        "valid_until",
        "revoked_at",
        "independent_reviewer"
      ],
      "properties": {
        "key_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "identity": {"type": "string", "minLength": 1, "maxLength": 300},
        "organization": {"type": "string", "minLength": 1, "maxLength": 300},
        "algorithm": {"const": "ed25519"},
        "public_key_pem": {"type": "string", "minLength": 1, "maxLength": 4096},
        "public_key_sha256": {"$ref": "#/$defs/sha256"},
        "purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["evidence_issuer", "acceptance_reviewer"]}
        },
        "authority_classes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"}
        },
        "allowed_gap_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {"type": "string", "pattern": "^HG-[0-9]{4}$"}
        },
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "revoked_at": {"type": ["string", "null"], "format": "date-time"},
        "independent_reviewer": {"type": "boolean"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.org/schemas/source-artifact-archive-receipt.schema.json",
  "title": "Hepta source Artifact archive receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "head_commit",
    "source_tree",
    "artifact_name",
    "artifact_sha256",
    "artifact_size_bytes",
    "archive_object",
    "archived_at",
    "retention_until",
    "custodian",
    "key_id",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"const": "TrillionniumFoundation/hepta-glasses"},
    "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact_name": {
      "type": "string",
      "pattern": "^hepta-source-evidence-[0-9a-f]{40}$",
      "maxLength": 128
    },
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_size_bytes": {"type": "integer", "minimum": 1, "maximum": 134217728},
    "archive_object": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "archived_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "retention_until": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "custodian": {"type": "string", "minLength": 1, "maxLength": 256},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$", "maxLength": 88}
  }
}

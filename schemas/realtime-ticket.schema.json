{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hepta.invalid/schemas/realtime-ticket-v1.json",
  "title": "RealtimeTicket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "bootstrap_token",
    "subject",
    "device_id",
    "scopes",
    "provider_profile",
    "expires_at"
  ],
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "bootstrap_token": {"type": "string", "minLength": 32},
    "subject": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "scopes": {
      "type": "array",
      "items": {
        "enum": [
          "audio.input",
          "audio.output",
          "transcript.delta",
          "tool.propose"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "provider_profile": {"type": "string", "minLength": 1},
    "expires_at": {"type": "integer", "minimum": 1}
  }
}

{
  "schema_version": 1,
  "contract_id": "durable-memory-v1",
  "parent_gap": "HG-0087",
  "owner": "privacy",
  "implementations": [
    "services/skills/durable_memory.py",
    "services/skills/durable_memory_schema.py"
  ],
  "tests": [
    "services/skills/test_durable_memory.py",
    "services/skills/test_durable_memory_schema.py"
  ],
  "persistence": {
    "engine": "SQLite WAL/FULL/BEGIN IMMEDIATE",
    "version": 1,
    "required_tables": [
      "memory_schema",
      "memory_consents",
      "memory_records",
      "memory_deletions"
    ],
    "missing_or_malformed_established_state": "reject; never recreate authority tables empty",
    "derived_indexes": "may be rebuilt from intact tables",
    "automatic_migration": false,
    "stale_snapshot_restore_supported": false
  },
  "cryptography": {
    "key_material_persisted": false,
    "plaintext_values_persisted": false,
    "cipher": "external deployment-supplied authenticated MemoryCipher",
    "aad_fields": [
      "memory_id",
      "subject",
      "purpose",
      "data_class",
      "created_at",
      "expires_at"
    ],
    "per_subject_key_rotation": true,
    "production_kms_or_hsm_included": false
  },
  "time": {
    "clock": "trusted host integer Unix seconds",
    "sample_after_write_lock": true,
    "write_recheck_after_encrypt_and_insert": true,
    "read_recheck_after_decrypt": true,
    "operation_local_clock_rollback": "reject and roll back",
    "global_or_backup_anti_rollback": false
  },
  "consent": {
    "scope": [
      "subject",
      "purpose",
      "allowed_data_classes",
      "absolute_expiry"
    ],
    "forbidden_classes": [
      "credential",
      "raw_audio",
      "secret"
    ],
    "narrowing": "delete disallowed ciphertext and create propagation tombstones",
    "expiry": "no stale write or decrypted delivery after final local check"
  },
  "deletion": {
    "atomic_with_local_ciphertext_removal": true,
    "cursor_paginated": true,
    "restart_safe": true,
    "acknowledgement_is_remote_deletion_evidence": false,
    "downstream_worker_included": false
  },
  "not_implemented": [
    "authenticated product ingress",
    "production per-subject KMS/HSM/platform key service",
    "migration from deployed predecessor formats",
    "encrypted backup exclusion, retention and trusted anti-rollback",
    "authenticated downstream deletion reconciliation",
    "independent privacy/security and deployment qualification"
  ],
  "claim_ceiling": "Source custody and deterministic tests only. Memory and aggregate HG-0087 remain OPEN."
}

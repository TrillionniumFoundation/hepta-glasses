{
  "schema_version": 2,
  "allowed_sandboxes": [
    "read-only",
    "workspace-write"
  ],
  "network_access_default": false,
  "require_network_isolation": true,
  "network_isolation_command": [
    "unshare",
    "--net",
    "--"
  ],
  "maximum_prompt_characters": 24000,
  "maximum_timeout_seconds": 1800,
  "maximum_output_bytes": 4194304,
  "executable": "codex"
}
